<?xml version="1.0" encoding="utf-8"?>
<!-- Original R2 password hierarchy on an immutable 1080 x 2242 design canvas. -->
<com.android.keyguard.SosKeyguardPasswordView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyguard_password_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/sos_password_design_canvas"
        android:layout_width="1080px"
        android:layout_height="2242px"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="48px"
            android:layout_marginTop="156px"
            android:fontFamily="@font/smartisan_compact_bold"
            android:gravity="start|top"
            android:minWidth="200px"
            android:minHeight="140px"
            android:text="@string/cancel"
            android:textColor="#ffffffff"
            android:textSize="42px"
            android:textStyle="bold" />

        <com.android.keyguard.EmergencyButton
            android:id="@+id/emergency_call_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="156px"
            android:layout_marginEnd="48px"
            android:fontFamily="@font/smartisan_compact_bold"
            android:gravity="end|top"
            android:minWidth="200px"
            android:minHeight="140px"
            android:text="@string/unlock_screen_btn_emergency"
            android:textColor="#ffffffff"
            android:textSize="42px"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/password_tips_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="588px"
            android:orientation="vertical">

            <com.android.keyguard.SosPasswordMessageArea
                android:id="@+id/bouncer_message_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/smartisan_compact_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/please_enter_easy_password"
                android:textColor="#ffffffff"
                android:textSize="48px"
                android:textStyle="bold" />

            <ViewStub
                android:id="@id/keystore_lock_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:layout="@layout/keystore_lock_tips" />
        </LinearLayout>

        <com.android.systemui.bouncer.ui.BouncerMessageView
            android:id="@+id/bouncer_message_view"
            android:layout_width="1px"
            android:layout_height="1px"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/password_entry_layout"
            android:layout_width="888px"
            android:layout_height="204px"
            android:layout_below="@id/password_tips_container"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="94.5px">

            <EditText
                android:id="@+id/passwordEntry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/password_input_bg"
                android:contentDescription="@string/keyguard_accessibility_password"
                android:fontFamily="@font/smartisan_compact_regular"
                android:gravity="center"
                android:imeOptions="flagForceAscii|actionDone"
                android:inputType="textPassword"
                android:paddingStart="60px"
                android:paddingEnd="60px"
                android:singleLine="true"
                android:textColor="#ffffffff"
                android:textCursorDrawable="@null"
                android:textSize="63px" />

            <ImageView
                android:id="@+id/switch_ime_button"
                android:layout_width="96px"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/accessibility_ime_switch_button"
                android:padding="24px"
                android:src="@drawable/ic_lockscreen_ime"
                android:tint="#ffffffff"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/password_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="32px"
            android:layout_marginEnd="32px"
            android:layout_marginBottom="830px"
            android:fontFamily="@font/smartisan_compact_regular"
            android:gravity="center_horizontal"
            android:textColor="#ffffffff"
            android:textSize="36px" />

        <View
            android:id="@+id/keyguard_selector_fade_container"
            android:layout_width="1px"
            android:layout_height="1px" />
    </RelativeLayout>
</com.android.keyguard.SosKeyguardPasswordView>
