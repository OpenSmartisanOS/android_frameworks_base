<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/res-auto">

    <com.android.keyguard.KeyguardPinFlowView
        android:id="@+id/flow1"
        android:layout_width="984px"
        android:layout_height="864px"
        android:layout_marginBottom="108px"
        android:orientation="horizontal"
        androidprv:constraint_referenced_ids="key1,key2,key3,key4,key5,key6,key7,key8,key9,emergency_call_button,key0,delete_button"
        androidprv:flow_horizontalGap="24px"
        androidprv:flow_horizontalStyle="packed"
        androidprv:flow_maxElementsWrap="3"
        androidprv:flow_verticalGap="24px"
        androidprv:flow_verticalStyle="packed"
        androidprv:flow_wrapMode="aligned"
        androidprv:layout_constraintBottom_toBottomOf="parent"
        androidprv:layout_constraintEnd_toEndOf="parent"
        androidprv:layout_constraintStart_toStartOf="parent" />

    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key1" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_1" android:contentDescription="@string/description_1" androidprv:digit="1" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key2" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_2" android:contentDescription="@string/description_2" androidprv:digit="2" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key3" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_3" android:contentDescription="@string/description_3" androidprv:digit="3" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key4" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_4" android:contentDescription="@string/description_4" androidprv:digit="4" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key5" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_5" android:contentDescription="@string/description_5" androidprv:digit="5" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key6" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_6" android:contentDescription="@string/description_6" androidprv:digit="6" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key7" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_7" android:contentDescription="@string/description_7" androidprv:digit="7" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key8" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_8" android:contentDescription="@string/description_8" androidprv:digit="8" />
    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key9" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_9" android:contentDescription="@string/description_9" androidprv:digit="9" />

    <com.android.keyguard.EmergencyButton
        android:id="@+id/emergency_call_button"
        android:layout_width="312px"
        android:layout_height="198px"
        android:background="@drawable/secletor_easy_password_keyboard_emergency"
        android:gravity="center"
        android:text="@string/unlock_screen_btn_emergency"
        android:textColor="#ffffffff"
        android:textSize="42px"
        android:textStyle="bold" />

    <com.android.keyguard.SosSimNumPadKey android:id="@+id/key0" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_0" android:contentDescription="@string/description_0" androidprv:digit="0" />
    <com.android.keyguard.SosNumPadButton android:id="@+id/delete_button" android:layout_width="312px" android:layout_height="198px" android:background="@drawable/secletor_easy_password_keyboard_delete" android:contentDescription="@string/keyboardview_keycode_delete" />
</merge>
