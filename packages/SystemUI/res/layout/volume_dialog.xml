<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/volume_dialog_panel_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volume_dialog_panel_scrim"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/volume_dialog_right_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.android.systemui.volume.ShadowFrameLayout
            android:id="@+id/volume_dialog_mute_shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:background="@drawable/ic_smartisan_volume_panel_shadow_bg">

            <FrameLayout
                android:id="@+id/volume_dialog_mute_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/active_bg">

                <ImageView
                    android:id="@+id/volume_dialog_mute_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/volume_dialog_mute"
                    android:scaleType="center"
                    android:src="@drawable/mute_close" />

                <FrameLayout
                    android:id="@+id/volume_dialog_mute_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <com.android.systemui.volume.widget.VCountDownTimerView
                        android:id="@+id/volume_dialog_mute_timer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal" />

                    <ImageView
                        android:id="@+id/volume_dialog_mute_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/cancel_mute_btn_bg"
                        android:clickable="true"
                        android:contentDescription="@string/volume_dialog_cancel_mute"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/cancel_mute_btn_icon" />
                </FrameLayout>
            </FrameLayout>
        </com.android.systemui.volume.ShadowFrameLayout>

        <com.android.systemui.volume.ShadowFrameLayout
            android:id="@+id/volume_dialog_main_shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:background="@drawable/ic_smartisan_volume_panel_shadow_bg"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/volume_dialog_main_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/active_bg_blue"
                android:clipChildren="false">

                <include
                    android:id="@+id/volume_dialog_brightness_column"
                    layout="@layout/volume_dialog_column" />

                <include
                    android:id="@+id/volume_dialog_ringer_column"
                    layout="@layout/volume_dialog_column" />

                <include
                    android:id="@+id/volume_dialog_media_column"
                    layout="@layout/volume_dialog_column" />
            </FrameLayout>
        </com.android.systemui.volume.ShadowFrameLayout>

        <com.android.systemui.volume.ShadowFrameLayout
            android:id="@+id/volume_dialog_expand_shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:background="@drawable/ic_smartisan_volume_panel_shadow_bg">

            <ImageView
                android:id="@+id/volume_dialog_expand_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/active_bg"
                android:contentDescription="@string/volume_dialog_expand"
                android:scaleType="center"
                android:src="@drawable/ic_smartisan_volume_new_open" />
        </com.android.systemui.volume.ShadowFrameLayout>
    </FrameLayout>
</FrameLayout>
