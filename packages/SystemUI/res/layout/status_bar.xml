<com.android.systemui.statusbar.phone.PhoneStatusBarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/res/com.android.systemui"
    android:id="@+id/status_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/status_bar_height"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:accessibilityPaneTitle="@string/status_bar">

    <ImageView
        android:id="@+id/notification_lights_out"
        android:layout_width="@dimen/status_bar_icon_height"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/status_bar_item_margin_start"
        android:paddingBottom="2dip"
        android:src="@drawable/ic_sysbar_lights_out_dot_small"
        android:scaleType="center"
        android:visibility="gone" />

    <com.android.systemui.statusbar.phone.StatusBarContentsLayout
        android:id="@+id/status_bar_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginStart="@dimen/status_bar_contents_margin_start"
        android:layout_marginEnd="@dimen/status_bar_contents_margin_end">

        <View
            android:id="@+id/camera_area"
            android:layout_width="@dimen/status_bar_camera_area_width"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Stable half-screen boundary used only by left/right cutout compositions. -->
        <View
            android:id="@+id/status_bar_center_boundary"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:visibility="invisible"
            android:importantForAccessibility="no" />

        <com.android.systemui.statusbar.policy.PrivacyHighlightView
            android:id="@+id/privacy_highlight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:clickable="false"
            android:focusable="false">

            <com.android.systemui.statusbar.policy.Clock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.StatusBar.Default"
                android:textColor="#ffffffff" />

            <ImageView
                android:id="@+id/privacy_icon"
                android:layout_width="@dimen/privacy_icon_size"
                android:layout_height="@dimen/privacy_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="invisible" />
        </com.android.systemui.statusbar.policy.PrivacyHighlightView>

        <LinearLayout
            android:id="@+id/status_bar_contents_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/privacy_highlight"
            android:clipChildren="false"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/network_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxWidth="@dimen/status_bar_network_label_max_width"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.StatusBar.Default"
                android:textColor="#ffffffff"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/sidebar_drag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="7px"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <com.android.systemui.statusbar.AlphaOptimizedFrameLayout
                android:id="@+id/notification_icon_area"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/status_bar_end_side_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/privacy_highlight">

            <include
                layout="@layout/system_icons"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.android.systemui.statusbar.phone.StatusBarContentsLayout>

    <include layout="@layout/heads_up_status_bar_layout" />

    <include
        layout="@layout/status_bar_ticker_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</com.android.systemui.statusbar.phone.PhoneStatusBarView>
