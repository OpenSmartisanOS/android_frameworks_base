<?xml version="1.0" encoding="utf-8"?>
<!-- Canonical Smartisan R2 system icon host. -->
<com.android.systemui.statusbar.phone.SystemIconsView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:systemui="http://schemas.android.com/apk/res-auto"
    android:id="@+id/system_icons"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical|end">

    <ImageView
        android:id="@+id/otg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/status_bar_icon_height"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="2px"
        android:layout_marginEnd="2px"
        android:src="@drawable/stat_sys_phone2phonecharging"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <com.android.systemui.battery.BatteryView
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/otg"
        android:layout_alignWithParentIfMissing="true"
        android:layout_marginStart="@dimen/status_bar_battery_margin_start"
        android:layout_marginEnd="@dimen/status_bar_battery_margin_end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="visible"
        systemui:textAppearance="@style/TextAppearance.StatusBar.Default" />

    <include
        layout="@layout/network_signal_cluster"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/battery"
        android:layout_alignWithParentIfMissing="true" />

    <LinearLayout
        android:id="@+id/net_speed_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/network_signal_cluster"
        android:layout_alignWithParentIfMissing="true"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:visibility="gone"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@id/net_speed_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:src="@drawable/stat_sys_data_down" />

        <TextView
            android:id="@id/net_speed"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="10.8dp"
            android:textStyle="bold" />

        <TextView
            android:id="@id/net_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="10.4dp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.android.systemui.statusbar.phone.StatusIconMerger
        android:id="@+id/statusIcons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/network_signal_cluster"
        android:layout_alignWithParentIfMissing="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="rtl" />
</com.android.systemui.statusbar.phone.SystemIconsView>
