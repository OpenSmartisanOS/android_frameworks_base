<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sos_panel_status_bar"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@drawable/sos_status_bar_background_opaque"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:importantForAccessibility="no"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sos_panel_status_bar_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sos_panel_status_bar_start_side_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false" />

        <Space
            android:id="@+id/sos_panel_display_cutout_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/sos_panel_status_bar_end_side_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <com.android.keyguard.AlphaOptimizedLinearLayout
                android:id="@+id/sos_panel_status_bar_end_side_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clipChildren="false"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.android.systemui.statusbar.LineageStatusBarItemHolder
                    android:id="@+id/sos_panel_network_traffic_holder_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:gravity="center"
                    android:paddingLeft="2dp">

                    <org.lineageos.internal.statusbar.NetworkTraffic
                        android:id="@+id/sos_panel_network_traffic_end"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.android.systemui.statusbar.LineageStatusBarItemHolder>

                <include
                    android:id="@+id/sos_panel_user_switcher_container"
                    layout="@layout/status_bar_user_chip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/status_bar_user_chip_end_margin" />

                <include
                    layout="@layout/system_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/status_bar_system_icons_height"
                    android:layout_gravity="center_vertical" />
            </com.android.keyguard.AlphaOptimizedLinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
