<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.statusbar.phone.NetworkSignalCluster
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/network_signal_cluster"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layoutDirection="ltr">

    <FrameLayout
        android:id="@+id/wifi_slot"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mobile_slot_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="ltr" />

    <ImageView
        android:id="@+id/no_sim_icon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/status_bar_icon_height"
        android:layout_marginStart="@dimen/status_bar_item_margin_start"
        android:layout_marginEnd="@dimen/status_bar_item_margin_end"
        android:src="@drawable/no_sim_icon"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/airplane_slot_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone" />
</com.android.systemui.statusbar.phone.NetworkSignalCluster>
