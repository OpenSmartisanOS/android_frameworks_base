<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shade_panel_status_bar"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:importantForAccessibility="no"
    android:visibility="gone">

    <RelativeLayout
        android:id="@+id/shade_panel_status_bar_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginStart="@dimen/sos_status_bar_contents_margin_start"
        android:layout_marginEnd="@dimen/sos_status_bar_contents_margin_end">

        <View
            android:id="@+id/shade_panel_display_cutout_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/status_bar_contents_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/shade_panel_display_cutout_space"
            android:clipChildren="false"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/network_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxWidth="@dimen/sos_status_bar_network_label_max_width"
                android:singleLine="true"
                android:textColor="#b3ffffff"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/status_bar_end_side_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/shade_panel_display_cutout_space">

            <include
                layout="@layout/system_icons_sos"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
