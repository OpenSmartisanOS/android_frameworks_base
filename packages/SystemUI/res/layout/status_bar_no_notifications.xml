<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.statusbar.notification.emptyshade.ui.view.EmptyShadeView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar_no_notifications"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notification_panel_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/empty_shade_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/empty_shade_datetime_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/empty_shade_time_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/empty_shade_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sos_android_clock"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#9a000000" />

                <TextView
                    android:id="@+id/empty_shade_am_pm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sos_android_clock"
                    android:includeFontPadding="false"
                    android:textColor="#9a000000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/empty_shade_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#66000000" />

                <TextView
                    android:id="@+id/empty_shade_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#66000000" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty_shade_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#66000000" />
        </LinearLayout>

        <View
            android:id="@+id/empty_shade_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/notification_empty" />

        <TextView
            android:id="@+id/no_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center|top"
            android:text="@string/empty_shade_text"
            android:textColor="#26000000"
            android:textStyle="bold" />

    </FrameLayout>
</com.android.systemui.statusbar.notification.emptyshade.ui.view.EmptyShadeView>
