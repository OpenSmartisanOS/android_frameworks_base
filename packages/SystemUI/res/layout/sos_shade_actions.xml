<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sos_shade_actions"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:layout_gravity="bottom"
    android:layout_marginBottom="@dimen/sos_shade_action_margin_bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/sos_shade_clear_all_button"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_gravity="center"
        android:background="@null"
        android:contentDescription="@string/accessibility_clear_all"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/sos_clear_all_bg"
        android:tint="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sos_shade_settings_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="@string/sos_shade_settings"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/sos_settings_bg"
        android:tint="@null" />
</FrameLayout>
