<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/onestep_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/onestep_sidebar_topview_top_bg"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/onestep_sidebar_topview_bottom_bg">

        <HorizontalScrollView
            android:id="@+id/onestep_target_scroll"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_gravity="top"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/onestep_target_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>
