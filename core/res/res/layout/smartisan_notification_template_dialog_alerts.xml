<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="336dp"
    android:layout_height="100dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginEnd="24dp">

        <ImageView
            android:id="@+id/dialog_alerts_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/dialog_alerts_title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="11dp"
            android:layout_toEndOf="@id/dialog_alerts_icon"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Sos.Notification.Dialog.Title" />

        <TextView
            android:id="@+id/dialog_alerts_text"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_below="@id/dialog_alerts_title"
            android:layout_toEndOf="@id/dialog_alerts_icon"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Sos.Notification.Text" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal" />
</LinearLayout>
