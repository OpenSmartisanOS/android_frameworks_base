<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SmartisanOS R2 notification design space. These are private framework resources. -->
    <!-- The original standalone header is 60dp; the ordinary row baseline is 106dp. -->
    <dimen name="sos_notification_min_height">106dp</dimen>
    <dimen name="sos_notification_max_height">373dp</dimen>
    <dimen name="sos_notification_heads_up_max_height">148dp</dimen>
    <dimen name="sos_notification_icon_size">36dp</dimen>
    <dimen name="sos_notification_icon_margin">12dp</dimen>
    <dimen name="sos_notification_content_margin_start">60dp</dimen>
    <dimen name="sos_notification_content_margin_end">12dp</dimen>
    <dimen name="sos_notification_content_margin_top">30.8dp</dimen>
    <dimen name="sos_notification_content_margin_bottom">10dp</dimen>
    <dimen name="sos_notification_min_content_height">39dp</dimen>
    <dimen name="sos_notification_action_height">48dp</dimen>
    <dimen name="sos_notification_action_text_size">14dp</dimen>
    <dimen name="sos_notification_title_text_size">13.5sp</dimen>
    <dimen name="sos_notification_text_size">12.5dp</dimen>
    <dimen name="sos_notification_time_text_size">12dp</dimen>
    <dimen name="sos_notification_header_margin_end">38dp</dimen>
    <dimen name="sos_notification_header_margin_top">9dp</dimen>
    <dimen name="sos_notification_text_margin_top">0.5dp</dimen>
    <dimen name="sos_notification_messaging_spacing">6dp</dimen>
    <dimen name="sos_notification_header_line_padding_top">10.4dp</dimen>
    <dimen name="smartisan_button_notification_content_margin_end">63dp</dimen>
    <dimen name="smartisan_meida_notification_content_margin_end">172dp</dimen>

    <color name="sos_notification_title_color">#9e000000</color>
    <color name="sos_notification_text_color">#ff9a9a9a</color>
    <color name="sos_notification_time_color">#66000000</color>
    <color name="sos_notification_tertiary_text_color">#33000000</color>
    <color name="sos_notification_action_color">#cccccc</color>

    <style name="TextAppearance.Sos.Notification.Title"
           parent="@style/TextAppearance.StatusBar.EventContent">
        <item name="android:textSize">@dimen/sos_notification_title_text_size</item>
        <item name="android:textColor">@color/sos_notification_title_color</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.Sos.Notification.Text"
           parent="@style/TextAppearance.StatusBar.EventContent.Info">
        <item name="android:textSize">@dimen/sos_notification_text_size</item>
        <item name="android:textColor">@color/sos_notification_text_color</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.Sos.Notification.Time"
           parent="@style/TextAppearance.StatusBar.EventContent.Info">
        <item name="android:textSize">@dimen/sos_notification_time_text_size</item>
        <item name="android:textColor">@color/sos_notification_time_color</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.Sos.Notification.Dialog.Title"
           parent="@style/TextAppearance.Sos.Notification.Title">
        <item name="android:textSize">15dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Sos.Notification.Dialog.Button"
           parent="@style/TextAppearance.Sos.Notification.Text">
        <item name="android:textSize">12.5dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sos_notification_title_color</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
